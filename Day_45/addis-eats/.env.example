# Every environment variable this app reads, with DUMMY values. This file is committed.
# Real values go in .env.local (gitignored; never commit it) or in Vercel → Settings →
# Environment Variables. Everything is optional: with none set, the app runs locally
# exactly as documented (in-memory store, localhost URLs, no third-party scripts).
#
#   copy .env.example .env.local      (macOS/Linux: cp .env.example .env.local)
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so never put a
# secret in one, and rebuild after changing them.

# ---------------------------------------------------------------- site URL (src/lib/site.js)
# Absolute origin for canonical links, og:url, og:image, sitemap.xml and robots.txt.
# On Vercel you usually DON'T need it: the production domain / preview URL is detected
# automatically. Set it for a custom domain. Locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://addis-eats.example.com

# ---------------------------------------------------------------- shared store (src/lib/store.js)
# Sessions and orders. REQUIRED when deployed on Vercel: without it each server instance
# has its own memory, so users get randomly signed out and orders "disappear".
# Vercel → Storage → Upstash Redis (free) sets these automatically. Leave empty locally.
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=dummy-token-replace-me

# ---------------------------------------------------------------- third parties (src/app/ThirdPartyScripts.jsx)
# Google Analytics 4 measurement ID. Empty = no analytics. Loaded with strategy="lazyOnload".
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Support-chat widget script (e.g. Tawk.to, Crisp). Empty = no chat. Loaded only when the
# visitor clicks "Chat with us" (a facade, see PERF.md).
NEXT_PUBLIC_CHAT_WIDGET_SRC=https://chat-widget.example.com/widget.js
