# Every environment variable Addis Eats reads, with DUMMY values. This file is committed;
# real values never are (.env.local is gitignored).
#
# LOCAL:   cp .env.example .env.local   (Windows: copy .env.example .env.local)
#          Everything is optional locally: with nothing set, the app runs with an
#          in-memory store, localhost URLs and no third-party scripts.
# VERCEL:  Project → Settings → Environment Variables. Each variable is set per
#          environment, exactly as in the table below. Redeploy after any change:
#          NEXT_PUBLIC_* values are baked into the JavaScript at BUILD time.
#
# ┌───────────────────────────────┬──────────────────────┬──────────────────────┬─────────────┐
# │ Variable                      │ Production           │ Preview              │ Development │
# ├───────────────────────────────┼──────────────────────┼──────────────────────┼─────────────┤
# │ UPSTASH_REDIS_REST_URL        │ REQUIRED (prod DB)   │ REQUIRED (2nd DB)    │ leave empty │
# │ UPSTASH_REDIS_REST_TOKEN      │ REQUIRED (prod DB)   │ REQUIRED (2nd DB)    │ leave empty │
# │ NEXT_PUBLIC_SITE_URL          │ only for a custom    │ do NOT set           │ leave empty │
# │                               │ domain               │ (preview URL is used)│             │
# │ NEXT_PUBLIC_GA_ID             │ your real GA4 ID     │ leave empty          │ leave empty │
# │ NEXT_PUBLIC_CHAT_WIDGET_SRC   │ your widget URL      │ optional             │ leave empty │
# └───────────────────────────────┴──────────────────────┴──────────────────────┴─────────────┘
# Why a separate Redis database for Preview: test orders and sign-ins on a preview
# deployment must not land in the real customers' data.

# ---------------------------------------------------------------- shared store (src/lib/store.js)
# Sessions, orders and the double-submit keys. Without it, each Vercel server instance
# has its own memory: users get signed out at random and orders "disappear".
# Vercel → Storage → Upstash (Redis), free tier, "Connect to project" fills these in.
# The KV_REST_API_URL / KV_REST_API_TOKEN names that integration may use also work.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=dummy-token-replace-me

# ---------------------------------------------------------------- site URL (src/lib/site.js)
# Absolute origin for canonical links, og:image, sitemap.xml and robots.txt.
# On Vercel the production domain / preview URL is detected automatically, so set
# this ONLY for a custom domain, and only in Production.
NEXT_PUBLIC_SITE_URL=https://addis-eats.example.com

# ---------------------------------------------------------------- third parties (src/app/ThirdPartyScripts.jsx)
# Google Analytics 4 measurement ID. Empty = no analytics. Production only, so tests
# on previews don't pollute the numbers.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Support-chat widget script. Empty = no chat button. Loaded only after a click.
NEXT_PUBLIC_CHAT_WIDGET_SRC=https://chat-widget.example.com/widget.js

# ---------------------------------------------------------------- set BY Vercel (never set these yourself)
# VERCEL=1                         on any Vercel build/runtime: enables the "no Redis" warning
# VERCEL_ENV=production|preview    which environment this deployment is
# VERCEL_URL                       this deployment's own URL (used for previews)
# VERCEL_PROJECT_PRODUCTION_URL    the production domain (used in production)
# VERCEL_GIT_COMMIT_SHA            shown by /api/health so you can tell which commit is live
